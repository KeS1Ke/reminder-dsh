{
  "name": "@kesike/reminder-dsh",
  "version": "0.2.1",
  "description": "Windows native notifications and taskbar badge for DeepSeek Harness: session-titled toasts with quick reply and approvals · DSH 的 Windows 原生通知与任务栏角标",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "src",
    "assets",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "lib",
    "README.zh-CN.md",
    "example.patch.yml"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:popup": "node scripts/test-popup.js",
    "test:settings-ui": "node test/settings.browser.js",
    "test:taskbar": "node scripts/test-taskbar.js"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KeS1Ke/reminder-dsh.git"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "windows",
    "notification"
  ],
  "license": "MIT",
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/cordis-plugin-loader": "1.1.0",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "playwright-core": "1.65.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.1 <0.3.0"
  },
  "displayName": "DSH reminders",
  "homepage": "https://github.com/KeS1Ke/reminder-dsh#readme",
  "bugs": {
    "url": "https://github.com/KeS1Ke/reminder-dsh/issues"
  }
}
