{
  "name": "@kesike/dsh-taskbar-reminder",
  "displayName": "dsh-taskbar-reminder",
  "version": "0.0.1",
  "type": "module",
  "description": "DSH(DeepSeek Harness) 任务栏提醒插件骨架。",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "plugin",
    "web",
    "taskbar",
    "reminder"
  ],
  "homepage": "https://github.com/KeS1Ke/dsh-taskbar-reminder#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KeS1Ke/dsh-taskbar-reminder.git"
  },
  "bugs": {
    "url": "https://github.com/KeS1Ke/dsh-taskbar-reminder/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.19.0 || >=24.0.0"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  }
}
